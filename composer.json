{
    "name": "jeytekdev/explain-lint-monorepo",
    "description": "Monorepo for the explain-lint packages (development only, not published to Packagist).",
    "type": "project",
    "license": "MIT",
    "private": true,
    "repositories": [
        {
            "type": "path",
            "url": "packages/core"
        },
        {
            "type": "path",
            "url": "packages/laravel"
        },
        {
            "type": "path",
            "url": "packages/doctrine"
        },
        {
            "type": "path",
            "url": "packages/yii2"
        },
        {
            "type": "path",
            "url": "packages/codeception"
        }
    ],
    "require": {
        "php": "^8.1",
        "jeytekdev/explain-lint": "@dev",
        "jeytekdev/explain-lint-laravel": "@dev",
        "jeytekdev/explain-lint-doctrine": "@dev",
        "jeytekdev/explain-lint-yii2": "@dev",
        "jeytekdev/explain-lint-codeception": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "orchestra/testbench": "^9.0",
        "doctrine/dbal": "^4.0",
        "yiisoft/yii2": "^2.0.45",
        "codeception/codeception": "^5.0",
        "symplify/monorepo-builder": "^11.2"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "yiisoft/yii2-composer": true
        }
    },
    "scripts": {
        "test": [
            "@test:core",
            "@test:laravel",
            "@test:doctrine",
            "@test:yii2",
            "@test:codeception"
        ],
        "test:core": "vendor/bin/phpunit -c packages/core/phpunit.xml.dist",
        "test:laravel": "vendor/bin/phpunit -c packages/laravel/phpunit.xml.dist",
        "test:doctrine": "vendor/bin/phpunit -c packages/doctrine/phpunit.xml.dist",
        "test:yii2": "vendor/bin/phpunit -c packages/yii2/phpunit.xml.dist",
        "test:codeception": "vendor/bin/phpunit -c packages/codeception/phpunit.xml.dist",
        "merge": "vendor/bin/monorepo-builder merge",
        "validate:monorepo": "vendor/bin/monorepo-builder validate"
    }
}
