{
    "name": "jeytekdev/explain-lint-doctrine",
    "description": "Doctrine DBAL bridge for jeytekdev/explain-lint — captures queries via a Driver\\Middleware and re-runs EXPLAIN on the same connection.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "doctrine",
        "dbal",
        "sql",
        "explain",
        "testing",
        "query-analysis"
    ],
    "homepage": "https://github.com/jeytekdev/explain-lint-doctrine",
    "support": {
        "issues": "https://github.com/jeytekdev/explain-lint-doctrine/issues",
        "source": "https://github.com/jeytekdev/explain-lint-doctrine"
    },
    "authors": [
        {
            "name": "Jeytekdev",
            "homepage": "https://github.com/jeytekdev"
        }
    ],
    "require": {
        "php": "^8.1",
        "jeytekdev/explain-lint": "^1.0",
        "doctrine/dbal": "^3.2 || ^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "ExplainLint\\Doctrine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ExplainLint\\Doctrine\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.x-dev"
        }
    }
}
